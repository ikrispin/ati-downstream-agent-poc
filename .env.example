# Native LSCore model connection. Copy this file to .env; never commit .env.
LSCORE_MODEL_NAME=replace-with-authorized-model
LSCORE_MODEL_BASE_URL=https://model.example.invalid/v1
LSCORE_MODEL_API_KEY=replace-with-authorized-key
LSCORE_URL=http://127.0.0.1:8140

# ATI contains domain tools only. LSCore owns model calls, tool scheduling and retries.
ATI_MCP_PORT=18143
ATI_STATE_DIR=.local/state
ATI_ENVIRONMENT=connected-organization
ATI_PRIORITY_RULE=affected_and_exploit
ATI_CONNECTION_REVISION=1
ATI_LIGHTSPEED_MCP_URL=https://replace-with-existing-lightspeed-mcp.invalid/mcp
ATI_SUPPORT_MCP_URL=https://replace-with-existing-support-mcp.invalid/mcp
ATI_SOURCE_TIMEOUT=35
# Client waiting timeout; it is NOT a native LSCore whole-run cancellation guarantee.
ATI_CLIENT_TIMEOUT=240
ATI_SOURCE_MODE=live
# For explicit synthetic tests only: ATI_SOURCE_MODE=fixture
# ATI_FIXTURE_FAIL_SOURCE=support
